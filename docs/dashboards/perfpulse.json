    {
      "id": 7,
      "type": "timeseries",
      "title": "Lifecycle By Surface",
      "description": "Expected, submitted, running-visible, and deleted workloads by surface.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_jobs_expected{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "expected {{surface}}"
        },
        {
          "refId": "B",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_jobs_submitted_total{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "submitted {{surface}}"
        },
        {
          "refId": "C",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_jobs_visible_total{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "running {{surface}}"
        },
        {
          "refId": "D",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_cleanup_deleted_total{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "deleted {{surface}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "axisLabel": "jobs",
            "drawStyle": "line",
            "fillOpacity": 5,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency",
      "description": "Weighted mean latency per surface from OTLP histogram sum/count. Ephemeral cron runs export cumulative histograms per testid, so rate() is unreliable.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_submission_duration_ms_sum{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])) / clamp_min(sum by (surface) (last_over_time(k6_perfpulse_submission_duration_ms_count{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])), 1)",
          "legendFormat": "submit avg {{surface}}"
        },
        {
          "refId": "B",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_visibility_latency_ms_sum{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])) / clamp_min(sum by (surface) (last_over_time(k6_perfpulse_visibility_latency_ms_count{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])), 1)",
          "legendFormat": "running avg {{surface}}"
        },
        {
          "refId": "C",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_kueue_admission_latency_ms_sum{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])) / clamp_min(sum by (surface) (last_over_time(k6_perfpulse_kueue_admission_latency_ms_count{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])), 1)",
          "legendFormat": "kueue admit avg {{surface}}"
        },
        {
          "refId": "D",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_completion_latency_ms_sum{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])) / clamp_min(sum by (surface) (last_over_time(k6_perfpulse_completion_latency_ms_count{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])), 1)",
          "legendFormat": "completion avg {{surface}}"
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.95, sum by (le, surface, testid) (last_over_time(k6_perfpulse_submission_duration_ms_bucket{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])))",
          "legendFormat": "submit p95 {{surface}} {{testid}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "axisLabel": "milliseconds",
            "drawStyle": "line",
            "fillOpacity": 5,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failures By Surface",
      "description": "Submit and visibility deficits plus failure counters over time. Deficits compare expected jobs to submitted or running-visible counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(sum by (surface) (last_over_time(k6_perfpulse_jobs_expected{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])) - sum by (surface) (last_over_time(k6_perfpulse_jobs_submitted_total{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])), 0)",
          "legendFormat": "submit deficit {{surface}}"
        },
        {
          "refId": "B",
          "expr": "clamp_min(sum by (surface) (last_over_time(k6_perfpulse_jobs_expected{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])) - sum by (surface) (last_over_time(k6_perfpulse_jobs_visible_total{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval])), 0)",
          "legendFormat": "visibility deficit {{surface}}"
        },
        {
          "refId": "C",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_jobs_submission_failed_total{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "submission failed {{surface}}"
        },
        {
          "refId": "D",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_jobs_visibility_failed_total{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "visibility failed {{surface}}"
        },
        {
          "refId": "E",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_cleanup_failed_total{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "cleanup failed {{surface}}"
        },
        {
          "refId": "F",
          "expr": "sum by (surface) (last_over_time(k6_perfpulse_jobs_completion_failed_total{testid=~\"$testid\",run_class=~\"$runClass\",surface=~\"$surface\",namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "completion failed {{surface}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "axisLabel": "failures",
            "drawStyle": "line",
            "fillOpacity": 5,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP And Checks",
      "description": "Runner HTTP request rate plus HTTP and check failure percentages.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(k6_http_reqs_total{testid=~\"$testid\",run_class=~\"$runClass\",namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "http {{name}}"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(k6_http_req_failed_total{testid=~\"$testid\",run_class=~\"$runClass\",namespace=~\"$namespace\"}[$__rate_interval])) / clamp_min(sum(rate(k6_http_reqs_total{testid=~\"$testid\",run_class=~\"$runClass\",namespace=~\"$namespace\"}[$__rate_interval])), 1)",
          "legendFormat": "http failed %"
        },
        {
          "refId": "C",
          "expr": "100 * sum(rate(k6_checks_total{testid=~\"$testid\",run_class=~\"$runClass\",namespace=~\"$namespace\",condition=\"zero\"}[$__rate_interval])) / clamp_min(sum(rate(k6_checks_total{testid=~\"$testid\",run_class=~\"$runClass\",namespace=~\"$namespace\",condition=~\"zero|nonzero\"}[$__rate_interval])), 1)",
          "legendFormat": "check failed %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "axisLabel": "rate / percent",
            "drawStyle": "line",
            "fillOpacity": 5,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
