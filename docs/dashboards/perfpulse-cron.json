    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Recent cron checks grouped by testid and surface. Use this to pick a failing testid for drilldown without guessing from the variable list.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Expected"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Completed"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Completion failed"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cleanup failed"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 38,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "testid"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "expr": "max by (testid, surface) (last_over_time(k6_perfpulse_jobs_expected{run_class=\"cron\",testid=~\"cron-.*\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "max by (testid, surface) (last_over_time(k6_perfpulse_jobs_completed_total{run_class=\"cron\",testid=~\"cron-.*\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "max by (testid, surface) (last_over_time(k6_perfpulse_jobs_completion_failed_total{run_class=\"cron\",testid=~\"cron-.*\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "max by (testid, surface) (last_over_time(k6_perfpulse_cleanup_failed_total{run_class=\"cron\",testid=~\"cron-.*\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ],
      "title": "Recent Cron Runs",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ],
      "type": "table"
