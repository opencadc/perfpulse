{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!artifacts",
      "!bun.lock",
      "!dist",
      "!docs/dashboards",
      "!node_modules",
      "!.cursor"
    ]
  }
}
