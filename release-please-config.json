{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "package-name": "perfpulse",
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "yaml",
          "path": "charts/cron/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "charts/cron/Chart.yaml",
          "jsonpath": "$.appVersion"
        },
        {
          "type": "generic",
          "path": "charts/cron/values.yaml"
        },
        {
          "type": "yaml",
          "path": "charts/campaign/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "charts/campaign/Chart.yaml",
          "jsonpath": "$.appVersion"
        },
        {
          "type": "generic",
          "path": "charts/campaign/values.yaml"
        }
      ]
    }
  }
}
